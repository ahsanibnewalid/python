# Copy this file to .env for local setup.
# NEVER commit .env or real secrets.

APP_ENV=development
FLASK_SECRET_KEY=replace-with-a-long-random-secret
ADMIN_USER=admin
# Generate with: python -c "from werkzeug.security import generate_password_hash; print(generate_password_hash('your-password'))"
ADMIN_PASSWORD_HASH=replace-with-a-werkzeug-password-hash
SITE_NAME=University Connect
COOKIE_SECURE=0
REQUIRE_HTTPS=0
TRUST_PROXY=0
