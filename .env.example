# Local/deployment bootstrap configuration
APP_ENV=development
ADMIN_USER=admin

# FIRST-ADMIN BOOTSTRAP ONLY.
# Set ADMIN_PASSWORD in your private .env or Render environment before the
# first deployment. The application hashes it immediately and stores the hash
# in PostgreSQL. Do not commit a real .env file.
ADMIN_PASSWORD=CHANGE_ME_BEFORE_FIRST_START
# Optional first-setup safety token for /admin/first-setup; remove it after setup.
ADMIN_BOOTSTRAP_TOKEN=CHANGE_ME

# Existing deployments may instead use a pre-generated hash:
# ADMIN_PASSWORD_HASH=PASTE_GENERATED_HASH_HERE

FLASK_SECRET_KEY=PASTE_A_LONG_RANDOM_SECRET_HERE
SITE_NAME=University Connect
COOKIE_SECURE=0
REQUIRE_HTTPS=0
TRUST_PROXY=0

# Production: paste the Internal Database URL from your Render PostgreSQL service.
DATABASE_URL=

# SaaS billing
BILLING_PROVIDER=manual
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
MONEYBAG_MERCHANT_API_KEY=

# Media storage: local for development; use s3/r2/b2 with credentials in production.
MEDIA_STORAGE=local
MEDIA_S3_BUCKET=
MEDIA_S3_ENDPOINT=
MEDIA_S3_REGION=auto
MEDIA_S3_ACCESS_KEY=
MEDIA_S3_SECRET_KEY=
MEDIA_S3_PREFIX=university-connect
